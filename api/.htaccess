Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # PHP source files that are part of the API may be loaded only through the
    # front controller. Existing public files are otherwise left untouched.
    RewriteRule ^src(?:/|$) - [F,L,NC]
    RewriteRule ^(?:config(?:\.example)?\.php|schema\.sql|README\.md)$ - [F,L,NC]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_authz_core.c>
    <FilesMatch "^(?:config(?:\.example)?\.php|schema\.sql|README\.md)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "^(?:config(?:\.example)?\.php|schema\.sql|README\.md)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Frame-Options "DENY"
</IfModule>

